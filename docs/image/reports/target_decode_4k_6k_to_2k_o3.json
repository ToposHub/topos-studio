    {
      "case": "4k_to_2k",
      "source": [4096, 2160],
      "target": [2048, 1080],
      "native_target": true,
      "p50_ms": 39.185,
      "p95_ms": 39.806,
      "p99_ms": 39.806,
      "max_ms": 39.823,
