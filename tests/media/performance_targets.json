    "p52_nv12_shader": {
      "fixture_id": "nv12_sample_1080p",
      "description": "NV12 YUV Shader 正确性测试目标",
      "targets": {
        "yuv_to_rgb_conversion": {
          "type": "shader_test",
          "test_points": [
            {"y": 16, "u": 128, "v": 128, "expected_r": 0, "expected_g": 0, "expected_b": 0, "description": "Black"},
            {"y": 235, "u": 128, "v": 128, "expected_r": 255, "expected_g": 255, "expected_b": 255, "description": "White"},
            {"y": 126, "u": 128, "v": 128, "expected_r": 126, "expected_g": 126, "expected_b": 126, "description": "Mid-gray"},
            {"y": 82, "u": 90, "v": 240, "expected_r": 255, "expected_g": 0, "expected_b": 0, "description": "Red"},
            {"y": 144, "u": 54, "v": 34, "expected_r": 0, "expected_g": 255, "expected_b": 0, "description": "Green"},
            {"y": 41, "u": 240, "v": 110, "expected_r": 0, "expected_g": 0, "expected_b": 255, "description": "Blue"}
          ],
          "tolerance": 2,
          "description": "BT.709 YUV to RGB 转换正确性",
          "phase": "P5-2"
        },
        "chroma_interpolation": {
          "type": "visual_test",
          "description": "色度插值正确性（半像素偏移）",
          "phase": "P5-2",
          "test_method": "visual_inspection"
        },
        "color_range_handling": {
          "type": "range_test",
          "tv_range_min": {"y": 16, "u": 16, "v": 16},
          "tv_range_max": {"y": 235, "u": 240, "v": 240},
          "full_range_min": {"y": 0, "u": 0, "v": 0},
          "full_range_max": {"y": 255, "u": 255, "v": 255},
          "description": "TV Range vs Full Range 处理",
          "phase": "P5-2"
        }
      },
      "test_scenarios": [
        "yuv_shader_correctness",
        "hw_decode_output_format"
      ]
    },
