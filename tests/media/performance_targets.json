            {"y": 64, "u": 512, "v": 512, "expected_r": 0, "expected_g": 0, "expected_b": 0, "description": "Black (10-bit)"},
            {"y": 940, "u": 512, "v": 512, "expected_r": 1023, "expected_g": 1023, "expected_b": 1023, "description": "White (10-bit)"},
            {"y": 512, "u": 512, "v": 512, "expected_r": 512, "expected_g": 512, "expected_b": 512, "description": "Mid-gray (10-bit)"}
          ],
          "tolerance": 4,
          "description": "10-bit BT.709 YUV to RGB 转换",
          "phase": "P5-2"
        },
        "pq_transfer_function": {
          "type": "shader_test",
          "test_points": [
            {"input": 0.0, "expected": 0.0, "description": "PQ EOTF: black"},
            {"input": 0.01, "expected_approx": 0.08, "description": "PQ EOTF: near black"},
            {"input": 0.5, "expected_approx": 0.52, "description": "PQ EOTF: mid"},
            {"input": 1.0, "expected": 1.0, "description": "PQ EOTF: peak"}
          ],
          "tolerance": 0.01,
          "description": "PQ EOTF 曲线正确性",
          "phase": "P5-2"
        },
        "bt2020_to_bt709_gamut_mapping": {
          "type": "gamut_test",
          "description": "BT.2020 色域映射到 BT.709",
          "phase": "P5-2",
          "test_method": "gamut_boundary_check"
        }
      },
      "test_scenarios": [
        "yuv_shader_correctness",
        "hdr_shader",
        "hw_decode_output_format"
      ]
    }
  },
  "target_types": {
    "max_ms": {
      "description": "最大时间（毫秒）",
      "check": "actual <= value + tolerance",
      "unit": "ms"
    },
    "max_p95_ms": {
      "description": "p95 分位时间上限（毫秒），迁移门禁（p95 不得退化超阈值）使用的百分位模型",
      "check": "percentile(actual_samples, 95) <= value + tolerance",
      "unit": "ms"
    },
    "min_p95_fps": {
      "description": "p95 分位有效帧率下限（fps），由帧时 p95 折算",
      "check": "1000.0 / percentile(frame_ms_samples, 95) >= value - tolerance",
      "unit": "fps"
    },
    "min_fps": {
      "description": "最小帧率",
      "check": "actual >= value - tolerance",
      "unit": "fps"
    },
    "max_drop_rate": {
      "description": "最大丢帧率",
      "check": "actual <= value + tolerance",
      "unit": "ratio (0-1)"
    },
    "max_mb": {
      "description": "最大内存（MB）",
      "check": "actual <= value + tolerance",
      "unit": "MB"
    },
    "shader_test": {
      "description": "Shader 正确性测试",
      "check": "point-wise comparison with tolerance",
      "unit": "pixels"
    },
    "visual_test": {
      "description": "视觉测试",
      "check": "manual inspection or automated visual diff",
      "unit": "pass/fail"
    },
    "boolean": {
      "description": "布尔值检查",
      "check": "actual == expected",
      "unit": "true/false"
    }
  },
  "validation_rules": {
    "all_fixtures": {
      "description": "所有素材必须满足的基本目标",
      "targets": {
        "open_ms": {"max": 500.0, "description": "打开时间上限"},
        "memory_stable": {"description": "长时间播放内存不增长"},
        "texture_stable": {"description": "长时间播放纹理不增长"}
      }
    },
    "hw_decode_required": {
      "description": "需要硬件解码器",
      "fixtures": ["h264_8bit_420_1080p", "h264_8bit_420_4k", "h265_10bit_420_4k"],
      "fallback_on_missing": true
    },
    "alpha_required": {
      "description": "需要 Alpha 通道支持",
      "fixtures": ["prores_4444_1080p", "prores_4444_4k"],
      "fallback_strategy": "convert_to_rgb_with_alpha"
    }
  },
  "hardware_requirements": {
    "hw_decode": {
      "description": "硬件解码器要求",
      "platforms": {
        "macos": {
          "min_version": "10.15",
          "features": ["VideoToolbox", "ProRes HW decode"],
          "supported_codecs": ["h264", "hevc", "prores"]
        },
        "windows": {
          "min_version": "10",
          "features": ["DXVA2", "D3D11VA"],
          "supported_codecs": ["h264", "hevc"]
        },
        "linux": {
          "features": ["VA-API", "NVDEC"],
          "supported_codecs": ["h264", "hevc"]
        }
      }
    },
    "hdr": {
      "description": "HDR 处理要求",
      "requirements": [
        "10-bit shader support",
        "PQ/HLG transfer function implementation",
        "BT.2020 gamut mapping"
      ]
    }
  }
}