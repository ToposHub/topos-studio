{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.1.0",
  "description": "P5-2 标准素材矩阵性能目标定义；1.1.0 新增 p95 百分位目标类型（P0-02，供迁移门禁使用，向后兼容）",
  "config": {
    "measurement_iterations": {
      "open_test": 5,
      "seek_test": 10,
      "decode_test": 100,
      "playback_test": 300
    },
    "tolerance_percent": {
      "fps": 5.0,
      "time_ms": 10.0,
      "drop_rate": 20.0
    },
    "hardware_requirements": {
      "min_cpu_cores": 4,
      "min_gpu_memory_mb": 1024,
      "min_system_memory_mb": 8192
    }
  },
  "performance_targets": {
    "p52_h264_8bit_420_1080p": {
      "fixture_id": "h264_8bit_420_1080p",
      "description": "H.264 8-bit 4:2:0 1080p 性能目标",
      "targets": {
        "open_ms": {
          "type": "max_ms",
          "value": 200.0,
          "tolerance_percent": 10.0,
          "description": "打开时间 < 200ms",
          "phase": "P5-2"
        },
        "seek_ms": {
          "type": "max_ms",
          "value": 50.0,
          "tolerance_percent": 10.0,
          "description": "随机 seek 时间 < 50ms",
          "phase": "P5-2"
        },
        "hw_decode_fps": {
          "type": "min_fps",
          "value": 60.0,
          "tolerance_percent": 5.0,
          "description": "硬件解码帧率 >= 60fps",
          "phase": "P5-2",
          "requirement": "需要硬件解码器支持"
        },
        "cpu_decode_fps": {
          "type": "min_fps",
          "value": 30.0,
          "tolerance_percent": 10.0,
          "description": "CPU 解码帧率 >= 30fps（fallback）",
          "phase": "P5-2",
          "requirement": "fallback 路径"
        },
        "proxy_decode_fps": {
          "type": "min_fps",
          "value": 120.0,
          "tolerance_percent": 5.0,
          "description": "Proxy 解码帧率 >= 120fps (50% scale)",
          "phase": "P5-2",
          "proxy_scale": 0.5
        },
        "displayed_fps": {
          "type": "min_fps",
          "value": 29.97,
          "tolerance_percent": 5.0,
          "description": "实际显示帧率 >= 视频帧率",
          "phase": "P5-2"
        },
        "drop_rate": {
          "type": "max_drop_rate",
          "value": 0.01,
          "tolerance_percent": 50.0,
          "description": "丢帧率 <= 1%",
          "phase": "P5-2"
        },
        "gpu_upload_ms": {
          "type": "max_ms",
          "value": 5.0,
          "tolerance_percent": 20.0,
          "description": "GPU 上传时间 < 5ms",
          "phase": "P5-2"
        },
        "memory_mb": {
          "type": "max_mb",
          "value": 100.0,
          "tolerance_percent": 20.0,
          "description": "内存使用 < 100MB",
          "phase": "P5-2"
        }
      },
      "test_scenarios": [
        "hw_acceleration",
        "proxy_playback",
        "seek_accuracy"
      ]
    },
