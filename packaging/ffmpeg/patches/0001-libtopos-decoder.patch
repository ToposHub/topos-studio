+ * License along with FFmpeg; if not, write to the GNU Lesser General
+ * Public License along with FFmpeg; if not, write to the Free
+ * Software Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * @file
+ * Topos Video Codec decoder wrapping the external libtopos_codec
+ * (all-intra frame codec; packets are self-contained frames).
+ *
+ * tc_frame_decode is a stateless pure function (spec §11.1): the two-phase
+ * entry (planes_out == NULL for geometry query) fills topos_frame_output,
+ * the second call decodes straight into the caller's planes.  Output samples
+ * are right-justified uint16 in the declared bit depth, which maps directly
+ * onto FFmpeg's planar 10/12-bit YUV pixel formats.
+ */
+
+#include "libavutil/imgutils.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "decode.h"
+
+#include "topos_codec.h"
+
+static av_cold int libtopos_decode_init(AVCodecContext *avctx)
+{
+    avctx->color_range = AVCOL_RANGE_MPEG;
+    return 0;
+}
+
+static int libtopos_pick_pix_fmt(const topos_frame_output *info)
+{
+    /* 4:2:2 = pixel_format 0（R4.2），4:4:4 = 1；样本右对齐 uint16 */
+    const int is_444 = info->pixel_format == 1;
+
+    if (info->bit_depth > 8 && info->bit_depth <= 10)
+        return is_444 ? AV_PIX_FMT_YUV444P10LE : AV_PIX_FMT_YUV422P10LE;
+    if (info->bit_depth > 10 && info->bit_depth <= 12)
+        return is_444 ? AV_PIX_FMT_YUV444P12LE : AV_PIX_FMT_YUV422P12LE;
+    return AV_PIX_FMT_NONE;
+}
+
+static int libtopos_decode_frame(AVCodecContext *avctx, AVFrame *frame,
+                                 int *got_frame, AVPacket *avpkt)
+{
+    topos_frame_output info;
+    uint16_t *planes_out[TC_FRAME_MAX_PLANES];
+    size_t strides[TC_FRAME_MAX_PLANES];
+    int32_t st;
+    int ret;
+
+    memset(&info, 0, sizeof(info));
+    info.struct_size = sizeof(info);
+    info.abi_version = TOPOS_CODEC_ABI_VERSION;
+
+    /* Phase 1: 结构解析 + 几何查询（不做 payload CRC）。 */
+    st = tc_frame_decode(avpkt->data, avpkt->size, NULL, NULL, &info);
+    if (st < 0) {
+        av_log(avctx, AV_LOG_ERROR, "libtopos: frame header rejected (%d)\n", st);
+        return AVERROR_INVALIDDATA;
+    }
+
+    ret = ff_set_dimensions(avctx, info.visible_width, info.visible_height);
+    if (ret < 0)
+        return ret;
+
+    ret = libtopos_pick_pix_fmt(&info);
+    if (ret == AV_PIX_FMT_NONE) {
+        av_log(avctx, AV_LOG_ERROR,
+               "libtopos: unsupported geometry (bd=%u pf=%u planes=%u alpha=%u)\n",
+               info.bit_depth, info.pixel_format, info.plane_count, info.alpha_mode);
+        return AVERROR_PATCHWELCOME;
+    }
+    avctx->pix_fmt = ret;
+
+    /* H.273 码值与 AVCodecContext 枚举同源，直接透传（界内才写）。 */
+    avctx->color_range = info.color_range ? AVCOL_RANGE_JPEG : AVCOL_RANGE_MPEG;
+    if (info.color_primaries < AVCOL_PRI_NB)
+        avctx->color_primaries = info.color_primaries;
+    if (info.color_transfer < AVCOL_TRC_NB)
+        avctx->color_trc = info.color_transfer;
+    if (info.color_matrix < AVCOL_SPC_NB)
+        avctx->colorspace = info.color_matrix;
+    if (info.chroma_siting == 1)
+        avctx->chroma_sample_location = AVCHROMA_LOC_LEFT;
+    else if (info.chroma_siting == 2)
+        avctx->chroma_sample_location = AVCHROMA_LOC_CENTER;
+    else
+        avctx->chroma_sample_location = AVCHROMA_LOC_UNSPECIFIED;
+    if (info.sar_num && info.sar_den)
+        avctx->sample_aspect_ratio = (AVRational){ info.sar_num, info.sar_den };
+
+    if ((ret = ff_get_buffer(avctx, frame, 0)) < 0)
+        return ret;
+
+    for (int p = 0; p < info.plane_count && p < TC_FRAME_MAX_PLANES; p++) {
+        planes_out[p] = (uint16_t *)frame->data[p];
+        strides[p]    = frame->linesize[p] / sizeof(uint16_t);
+    }
+
+    /* Phase 2: 整帧解码直写 AVFrame 平面（slice 损坏按 §9 conceal 仍交付）。 */
+    st = tc_frame_decode(avpkt->data, avpkt->size, planes_out, strides, &info);
+    if (st < 0) {
+        av_log(avctx, AV_LOG_ERROR, "libtopos: decode failed (%d)\n", st);
+        av_frame_unref(frame);
+        return AVERROR_INVALIDDATA;
+    }
+    if (st == TC_WARN_CONCEALED)
+        av_log(avctx, AV_LOG_WARNING,
+               "libtopos: concealed %u/%u slices\n",
+               info.concealed_slices, info.slice_count);
+
+    frame->pict_type = AV_PICTURE_TYPE_I;
+    *got_frame = 1;
+    return avpkt->size;
+}
+
+const FFCodec ff_libtopos_decoder = {
+    .p.name          = "libtopos",
+    CODEC_LONG_NAME("Topos Video Codec 2.0 (libtopos_codec)"),
+    .p.type          = AVMEDIA_TYPE_VIDEO,
+    .p.id            = AV_CODEC_ID_LIBTOPOS,
+    .init            = libtopos_decode_init,
+    FF_CODEC_DECODE_CB(libtopos_decode_frame),
+    .p.capabilities  = AV_CODEC_CAP_DR1,
+    .p.pix_fmts      = (const enum AVPixelFormat[]) {
+        AV_PIX_FMT_YUV422P10LE, AV_PIX_FMT_YUV444P10LE,
+        AV_PIX_FMT_YUV422P12LE, AV_PIX_FMT_YUV444P12LE,
+        AV_PIX_FMT_NONE
+    },
+    .p.wrapper_name  = "libtopos",
+};
