// --- Topos Plugin Metadata ---
// @name Bokeh Defocus
// @i18n_name Bokeh_Defocus
// @author Topos Team
// @version 1.0
// @description Defocus blur with selectable iris: staggered-ring circular disc or aligned-ring hexagonal aperture, compile-time shell presets
// @input_space scene-linear
// @output_space scene-linear
// @alpha premultiplied
// @precision float16
// @determinism deterministic
// @export_support video
// @threading gpu
// @graphics_backends opengl
// @compute_backends glsl_fragment
// @preview_cost medium
// @param select bokeh_quality "Disc Quality" 1 "2 Shells" "3 Shells" "4 Shells"
// @param slider bokeh_radius "Defocus Radius" 0.35 0.0 1.0
// @param separator
// @param select iris_shape "Iris Shape" 0 "Circle" "Hexagon"
// -----------------------------
//
// Bokeh Defocus —— 光圈散焦（bokeh）。
//
// 原理：单 pass 圆盘/六边形核。核 = 中心 tap + N 层同心环 tap：
// 圆形光圈用 8 方向 45 度环并逐环错位 10 度（const mat2 旋转 +
// mix 近似插值，Skin_Even_Matte 的 stagger 惯例）提升圆盘覆盖率；
// 六边形光圈用 6 方向 60 度环且不逐环错位——各环保持对齐，散焦
// 高光呈现真实六边形光圈叶片形状。
//
// 与现有模糊插件的差异：Radial_Blur_Pro 是放射 streak、
// bilateral_skin_smooth 是皮肤门控双边、Skin_Even_Matte 是肤色门控
// 频率分离；本插件是无门控的纯光学散焦，重点在光圈形状。
//
// 设计要点：
// - 环层数 select 三档（2/3/4 层 → 圆形 17/25/33 tap、六边形
//   13/19/25 tap），BK_ACCUM 宏展开为编译期常量循环（两层嵌套上限
//   均为宏参数在调用点的字面常量）；
// - 环步长 = radius_uv / SHELLS（radius_px 逐轴换算 UV）：三档覆盖同一
//   散焦半径，只改密度；
// - 环权 1.0 - 0.12*ring 近似高斯边沿衰减；w_sum 含中心基线 1.0，
//   归一化分母恒 > 0；
// - 线性平均无 clamp 触碰内容色（HDR 安全）；采样 UV 钳半纹素；
//   Delta 输出惯例（散焦差值叠加到已调色画面）；
// - 参数 ABI：@param 以裸名引用（编译期改写为命名空间 uniform），
//   禁止引用未声明的 u_* 标识符（P0-COL-01）。

const vec2 BK_CIRC_DIRS[8] = vec2[8](
    vec2( 1.00000000,  0.00000000),
    vec2( 0.70710678,  0.70710678),
    vec2( 0.00000000,  1.00000000),
    vec2(-0.70710678,  0.70710678),
    vec2(-1.00000000,  0.00000000),
    vec2(-0.70710678, -0.70710678),
    vec2( 0.00000000, -1.00000000),
    vec2( 0.70710678, -0.70710678)
);

const vec2 BK_HEX_DIRS[6] = vec2[6](
    vec2( 1.00000000,  0.00000000),
    vec2( 0.50000000,  0.86602540),
    vec2(-0.50000000,  0.86602540),
    vec2(-1.00000000,  0.00000000),
    vec2(-0.50000000, -0.86602540),
    vec2( 0.50000000, -0.86602540)
);

// 10 度旋转矩阵（列主序，编译期常量）：圆形光圈的逐环错位
const mat2 BK_RING_STAGGER = mat2(0.98480775, 0.17364818,
                                  -0.17364818, 0.98480775);

// 环形累加宏。TABLE/COUNT/SHELLS/STAGGER 在调用点均为字面常量；
// 依赖外层作用域变量：uv / radius_uv / min_uv / max_uv / center_col。
// 采样偏移逐轴除以纹理尺寸（radius_uv 已换算），像素域圆盘各向同性。
#define BK_ACCUM(TABLE, COUNT, SHELLS, STAGGER)                                \
    vec3 acc = center_col;                                                     \
    float w_sum = 1.0;                                                         \
    vec2 step_uv = radius_uv / float(SHELLS);                                  \
    for (int shell = 0; shell < SHELLS; shell++) {                             \
        float shell_w = 1.0 - 0.12 * float(shell);                             \
        for (int t = 0; t < COUNT; t++) {                                      \
            vec2 dir = TABLE[t];                                               \
            vec2 stag = BK_RING_STAGGER * dir;                                 \
            dir = mix(dir, stag, float(shell) * float(STAGGER));               \
            vec3 s = texture(u_input_tex,                                      \
                clamp(uv + dir * (step_uv * float(shell + 1)),                 \
                      min_uv, max_uv)).rgb;                                    \
            acc += s * shell_w;                                                \
            w_sum += shell_w;                                                  \
        }                                                                      \
    }                                                                          \
    return acc / w_sum;

// 圆形光圈：8 方向、逐环 10 度错位（近似连续圆盘）
vec3 bokeh_circle(vec2 uv, vec2 radius_uv, vec2 min_uv, vec2 max_uv,
                  vec3 center_col, int quality) {
    if (quality == 0) { BK_ACCUM(BK_CIRC_DIRS, 8, 2, 1) }
    else if (quality == 1) { BK_ACCUM(BK_CIRC_DIRS, 8, 3, 1) }
    else { BK_ACCUM(BK_CIRC_DIRS, 8, 4, 1) }
}

// 六边形光圈：6 方向、各环对齐（保留光圈叶片形状）
vec3 bokeh_hexagon(vec2 uv, vec2 radius_uv, vec2 min_uv, vec2 max_uv,
                   vec3 center_col, int quality) {
    if (quality == 0) { BK_ACCUM(BK_HEX_DIRS, 6, 2, 0) }
    else if (quality == 1) { BK_ACCUM(BK_HEX_DIRS, 6, 3, 0) }
    else { BK_ACCUM(BK_HEX_DIRS, 6, 4, 0) }
}

vec3 process(vec3 color, vec2 uv) {
    // 首行早退出：零半径纯直通
    if (bokeh_radius < 0.001) return color;

    vec2 tex_size = vec2(textureSize(u_input_tex, 0));
    vec2 safe_size = max(tex_size, vec2(1.0));
    vec2 half_texel = 0.5 / safe_size;
    vec2 min_uv = half_texel;
    vec2 max_uv = vec2(1.0) - half_texel;

    // 散焦半径：上限画幅宽度的 3%（4K 下约 115 px），逐轴换算为 UV
    // 偏移量纲后再参与采样偏移（像素域圆盘各向同性）
    float radius_px = 1.0 + bokeh_radius * 0.03 * safe_size.x;
    vec2 radius_uv = vec2(radius_px) / safe_size;
    vec3 center_col = texture(u_input_tex, uv).rgb;

    vec3 blurred;
    if (iris_shape == 0) {
        blurred = bokeh_circle(uv, radius_uv, min_uv, max_uv, center_col, bokeh_quality);
    } else {
        blurred = bokeh_hexagon(uv, radius_uv, min_uv, max_uv, center_col, bokeh_quality);
    }

    return color + (blurred - center_col);
}
