// --- Topos Plugin Metadata ---
// @name Bilateral Skin Smooth
// @i18n_name bilateral_skin_smooth
// @author Topos Team
// @version 6.0 (Simplified)
// @param slider strength "Strength" 0.8 0.0 1.0
// @param slider radius "Radius" 0.0 0.0 1.0
// @param slider threshold "Detail Protection" 0.1 0.0 1.0
// @param separator
// @param slider recover "Detail Recover" 0.4 0.0 1.0
// -----------------------------

// ====== CONSTANTS FOR FERMAT SPIRAL SAMPLING ======
// 32 dithered spiral taps: combined with per-pixel edge weights and the
// second refinement pass, this matches the visual quality of the previous
// 64-tap version at half the texture-fetch cost (was the #1 playback
// bottleneck on 4K timelines).
const int NUM_SPIRAL_SAMPLES = 32;
const float GOLDEN_ANGLE = 2.39996322972;

// ====== UTILITY FUNCTIONS ======

vec3 srgbToLinear(vec3 c) {
    return mix(c / 12.92, pow((c * 0.94786729858) + 0.05213270142, vec3(2.4)), step(0.04045, c));
}

vec3 linearToSrgb(vec3 c) {
    return mix(c * 12.92, (pow(c, vec3(0.41666666667)) * 1.055) - 0.055, step(0.0031308, c));
}

// ====== GUIDED FILTER BOX SMOOTHING ======

// Strong box-filter style smoothing with edge protection
vec3 guidedBoxSmooth(vec2 uv, vec2 tex_offset, vec3 center_linear,
                     float radius_pix, float edge_thresh) {
    vec3 sum_color = vec3(0.0);
    float sum_weight = 0.0;

    float epsilon2 = edge_thresh * edge_thresh;

    for (int i = 0; i < NUM_SPIRAL_SAMPLES; i++) {
        // Fermat spiral: uniform disk distribution
        float r = sqrt(float(i) + 0.5) / sqrt(float(NUM_SPIRAL_SAMPLES));
        float theta = float(i) * GOLDEN_ANGLE;

        vec2 sample_offset = vec2(cos(theta), sin(theta)) * r * radius_pix * tex_offset;
        vec3 sample_col = texture(u_input_tex, uv + sample_offset).rgb;
        vec3 sample_linear = srgbToLinear(sample_col);

        // Edge-aware weight
        vec3 diff = sample_linear - center_linear;
        float dist2 = dot(diff, diff);
        
        // Strong edge protection: samples similar to center get higher weight
        float edge_weight = epsilon2 / (dist2 + epsilon2);

        sum_color += sample_linear * edge_weight;
        sum_weight += edge_weight;
    }

    return sum_color / max(sum_weight, 0.001);
}

// Multi-pass guided filter for stronger smoothing
vec3 multiPassGuidedSmooth(vec2 uv, vec2 tex_offset, vec3 center_linear,
                           float radius_pix, float detail_protection) {
    // Edge threshold: lower = more smoothing, higher = more protection
    // detail_protection: 0 = no protection (strong smooth), 1 = high protection (light smooth)
    float edge_thresh = mix(0.08, 0.35, detail_protection);

    // First pass: strong smoothing
    vec3 pass1 = guidedBoxSmooth(uv, tex_offset, center_linear, radius_pix, edge_thresh);

    // Second pass: slightly smaller radius for refinement
    vec3 pass2 = guidedBoxSmooth(uv, tex_offset, pass1, radius_pix * 0.7, edge_thresh * 0.8);

    // Blend passes
    return mix(pass1, pass2, 0.4);
}

// ====== FREQUENCY SEPARATION ======

vec3 extractHighFrequency(vec3 center_linear, vec3 smoothed, float detail_protection) {
    vec3 high_freq = center_linear - smoothed;

    // Threshold scales with protection level
    float thresh = mix(0.04, 0.12, detail_protection);
    vec3 detail_threshold = vec3(thresh);

    // Soft threshold mask
    vec3 detail_mask = vec3(
        smoothstep(detail_threshold.r * 0.5, detail_threshold.r * 1.5, abs(high_freq.r)),
        smoothstep(detail_threshold.g * 0.5, detail_threshold.g * 1.5, abs(high_freq.g)),
        smoothstep(detail_threshold.b * 0.5, detail_threshold.b * 1.5, abs(high_freq.b))
    );
    detail_mask = 1.0 - detail_mask;

    return high_freq * detail_mask;
}

// ====== MAIN PROCESS FUNCTION ======

vec3 process(vec3 color, vec2 uv) {
    if (strength < 0.001) return color;

    // ====== RESOLUTION SETUP ======
    vec2 current_size = vec2(textureSize(u_input_tex, 0));
    vec2 tex_offset = 1.0 / current_size;

    vec3 center_srgb = texture(u_input_tex, uv).rgb;
    vec3 center_linear = srgbToLinear(center_srgb);

    // ====== PARAMETER MAPPING ======
    // Radius: 0-1 -> 0.8% - 4% of image width
    float min_radius_ratio = 0.008;
    float max_radius_ratio = 0.04;
    float radius_ratio = min_radius_ratio + radius * (max_radius_ratio - min_radius_ratio);
    float radius_pix = max(3.0, current_size.x * radius_ratio);

    float detail_protection = threshold;

    // ====== 1. MULTI-PASS GUIDED FILTER SMOOTHING ======
    vec3 smoothed = multiPassGuidedSmooth(uv, tex_offset, center_linear,
                                          radius_pix, detail_protection);

    // ====== 2. APPLY STRENGTH ======
    // Enhanced strength curve for more visible effect
    float strength_curve = 1.0 - pow(1.0 - strength, 1.5);
    smoothed = mix(center_linear, smoothed, strength_curve);

    // ====== 3. DETAIL RECOVERY ======
    if (recover > 0.01) {
        vec3 high_freq = extractHighFrequency(center_linear, smoothed, detail_protection);
        
        // Scale factor incorporated into recover parameter
        float detail_scale = 0.8 + recover * 1.2;
        vec3 detail = high_freq * recover * detail_scale;
        detail = clamp(detail, -0.35, 0.35);
        smoothed += detail;
    }

    // ====== 4. OUTPUT ======
    vec3 smoothed_srgb = linearToSrgb(smoothed);
    vec3 delta = smoothed_srgb - center_srgb;

    return color + delta;
}