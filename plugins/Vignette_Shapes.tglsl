// --- Topos Plugin Metadata ---
// @name Vignette Shapes
// @i18n_name Vignette_Shapes
// @author Topos Team
// @version 1.0
// @description Multi-shape vignette (ellipse / rectangle / circle) with smoothstep feather, strength blend and mean-preserving luma compensation
// @input_space scene-linear
// @output_space scene-linear
// @determinism deterministic
// @preview_cost low
// @param select shape "Shape" 0 "Ellipse" "Rectangle" "Circle"
// @param slider feather "Feather" 0.5 0.0 1.0
// @param separator
// @param slider strength "Strength" 0.5 0.0 1.0
// @param slider luma_comp "Luma Compensation" 0.0 0.0 1.0
// -----------------------------

// Multi-shape vignette. Pure per-pixel math on uv (zero texture taps), so the
// output is deterministic and the 4K cost is a handful of ALU ops per pixel.
//
// Design notes (full derivations in docs/plugins/2026-09-28/specs/Vignette_Shapes.md):
// - Frame coords q = (uv - 0.5) * 2.0 span [-1, 1]^2 (corners at length sqrt(2)).
//   Each shape defines a distance-like scalar d with d = 1.0 on its nominal
//   boundary:
//     ellipse (0): d = length(q)               frame-inscribed oval, aspect-free
//     rect    (1): d = 1.0 + rounded_box_sdf   frame rectangle with rounded corners
//     circle  (2): d = length(q.x*aspect, q.y) geometric circle touching the
//                                             top/bottom edges (aspect-true)
// - The falloff t = smoothstep(1.0 - w, 1.0 + w, d) puts its 50 percent point
//   exactly on the nominal boundary, so the selected shape always reads true
//   at any feather setting.
// - Feather maps to the transition half-width w = mix(0.08, 0.55, feather);
//   w never reaches 0, so smoothstep always has edge0 < edge1 (no internal
//   division by zero) and even feather = 0 keeps a thin anti-aliased ramp.
// - Darkening is multiplicative: weight = 1.0 - strength * t. Multiplication
//   is HDR-safe in scene-linear space: negatives and super-whites scale by
//   the same factor, hue ratios are preserved, and no clamp(0,1) ever touches
//   image content (display-range handling belongs to the soft-clip stage).
//   This is deliberately stronger engineering than a mix-to-black vignette:
//   a mix pulls every pixel toward the same constant and shifts hue/hue
//   ratios under HDR values, while a gain does not.
// - Luma compensation keeps the frame average from dropping: the
//   multiplicative mask lowers the frame mean by strength * E[t], where E[t]
//   is the frame-average of the falloff field. Each shape carries a
//   closed-form approximation of E[t] (numerically calibrated; worst-case
//   error about 0.04, see spec section 3.4), and the corrective gain
//   1.0 / (1.0 - strength * E[t]) is blended in by the luma_comp slider
//   (0 = classic vignette, 1 = mean-preserving for a flat field).
// - Only the built-in u_aspect_ratio uniform is referenced (whitelisted);
//   no u_input_tex sampling. P0-COL-01 lesson: never reference undeclared
//   u_* identifiers - the compiler rewrite skips them and the whole layer
//   gets silently skipped at runtime.
// - Loop-free by construction, so the compile-time loop-bound rule holds
//   vacuously; no sin/cos/pow/exp/log anywhere in the math.

// Rounded-box signed distance function (canonical cheap form: abs / max /
// min / one length). p is centered, b the half extents, r the corner radius.
// Negative inside, zero on the boundary, positive outside.
float rounded_box_sdf(vec2 p, vec2 b, float r) {
    vec2 q = abs(p) - b + r;
    return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r;
}

// Normalized shape distance: 0.0 at frame center, 1.0 on the nominal shape
// boundary, > 1.0 outside. Dispatch follows the select early-return if-chain
// convention (see Color_Space_Transform); final else = circle (fallback).
float shape_distance(vec2 q, float aspect, float corner_r, int shape_idx) {
    if (shape_idx == 0) {
        // Ellipse: inscribed in the frame by construction, so the metric is
        // deliberately aspect-free - this mode tracks the frame proportions.
        return length(q);
    } else if (shape_idx == 1) {
        // Rectangle: frame-matched rounded box in aspect-corrected space, so
        // the corner rounding stays geometrically circular in pixels.
        return 1.0 + rounded_box_sdf(vec2(q.x * aspect, q.y),
                                     vec2(aspect, 1.0), corner_r);
    } else {
        // Circle: aspect-corrected metric (radial effects must multiply
        // u_aspect_ratio to cancel UV stretching); boundary = inscribed circle.
        return length(vec2(q.x * aspect, q.y));
    }
}

// Closed-form frame-average of the falloff field, E[t], per shape - the luma
// compensation calibration. Derivations and accuracy tables in spec 3.4.
// All denominators are floored and aspect-dependent terms stay bounded.
float falloff_mean(int shape_idx, float w, float aspect) {
    if (shape_idx == 0) {
        // Ellipse lives in q-space, so its frame mean is aspect-free.
        return 0.207 + 0.131 * w;
    } else if (shape_idx == 1) {
        // Rectangle darkens a border band of area ~ perimeter * w; the 0.181
        // factor folds in the smoothstep band average and corner rounding.
        return 0.181 * (1.0 + 1.0 / max(aspect, 0.1)) * w;
    } else {
        // Circle: hard term = frame-area fraction outside the inscribed
        // circle, exactly 1 - PI/(4A) for A >= 1 (PI/4 = 0.7853982); below
        // A = 1 a linear fit of the exact corner-sliver integral; plus a
        // small feather slope term (max() floors keep it positive).
        float hard = (aspect >= 1.0)
            ? max(1.0 - 0.7853982 / max(aspect, 0.1), 0.0)
            : max(0.215 - 0.36 * (1.0 - aspect), 0.0);
        float slope = 0.131 + 0.12 * max(1.0 - aspect, 0.0)
                    - 0.336 * max(aspect - 1.0, 0.0);
        return hard + max(slope, 0.007) * w;
    }
}

vec3 process(vec3 color, vec2 uv) {
    // Early exit: zero strength is a pure passthrough (the compensation gain
    // is proportional to strength, so it is a no-op here as well).
    if (strength < 0.001) return color;

    // Transition half-width; floored at 0.08 so the smoothstep edges never
    // meet and feather = 0 still yields a thin anti-aliased ramp.
    float w = mix(0.08, 0.55, feather);
    // Corner radius of rectangle mode, tied to feather: hard edge -> sharp
    // corners, soft edge -> rounder corners (image-editor mask behaviour).
    float corner_r = 0.9 * w;

    // Frame coords in [-1, 1]^2.
    vec2 q = (uv - 0.5) * 2.0;

    // Falloff t in [0, 1]: 0 at center, 1 fully outside the boundary band.
    float d = shape_distance(q, u_aspect_ratio, corner_r, shape);
    float t = smoothstep(1.0 - w, 1.0 + w, d);

    // Multiplicative darkening: HDR-safe, no clamp on content values.
    float weight = 1.0 - strength * t;

    // Mean-preserving luma compensation: blend from 1.0 (off) to the
    // corrective gain 1.0 / E[weight]; denominator floored at 0.25, so the
    // gain stays bounded at 4.0 even at full strength on the darkest shape.
    float mean_t = falloff_mean(shape, w, u_aspect_ratio);
    float mean_weight = max(1.0 - strength * mean_t, 0.25);
    float gain = mix(1.0, 1.0 / mean_weight, luma_comp);

    return color * weight * gain;
}
